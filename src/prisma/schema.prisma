generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["better-auth", "finance-assets"]
}

model User {
  id                String             @id
  name              String
  email             String
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  assetCategories   AssetCategory[]
  assetWishlists    AssetWishlists[]
  assetDividends    AssetDividend[]
  assetTransactions AssetTransaction[]
  priceAlerts       PriceAlert[]
  patrimonyItems    PatrimonyItem[]

  @@unique([email])
  @@index([email])
  @@map("user")
  @@schema("better-auth")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("better-auth")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
  @@schema("better-auth")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("better-auth")
}

model Asset {
  id                  String              @id @default(uuid())
  categoryId          String
  name                String
  ticker              String
  quantity            Decimal?            @db.Decimal(15, 8)
  averagePrice        Decimal?            @db.Decimal(15, 4)
  broker              String?
  isActive            Boolean             @default(true)
  // Ativo com cotação de mercado: o preço vem de `marketAsset`
  marketAssetId       String?
  // Preço manual, usado só sem `marketAsset` (ex.: renda fixa)
  currentClosePrice   Decimal?            @db.Decimal(15, 4)
  // Quando o histórico de proventos foi importado (backfill); null = ainda não importado
  dividendsImportedAt DateTime?
  // Renda fixa com saldo calculado pelo indexador (null = saldo manual)
  indexer             FixedIncomeIndexer?
  /// CDI: % do CDI (110 = 110%); IPCA: taxa real ao ano; PRE: taxa ao ano
  indexerRate         Decimal?            @db.Decimal(10, 4)
  investedAt          DateTime?           @db.Date
  maturityAt          DateTime?           @db.Date
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  category     AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  marketAsset  MarketAsset?       @relation(fields: [marketAssetId], references: [id], onDelete: SetNull)
  dividends    AssetDividend[]
  transactions AssetTransaction[]
  priceAlerts  PriceAlert[]

  @@index([categoryId])
  @@index([marketAssetId])
  @@index([ticker])
  @@index([categoryId, ticker])
  @@map("assets")
  @@schema("finance-assets")
}

model AssetCategory {
  id               String       @id @default(uuid())
  userId           String
  name             String
  type             CategoryType @default(FIXED)
  targetPercentage Decimal?     @db.Decimal(5, 2)
  currency         String       @default("BRL")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  records        AssetRecord[]
  competences    AssetCategoryCompetence[]
  assets         Asset[]
  assetWishlists AssetWishlists[]
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("asset_categories")
  @@schema("finance-assets")
}

model AssetWishlists {
  id            String   @id @default(uuid())
  userId        String
  categoryId    String
  name          String
  ticker        String
  targetPrice   Decimal? @db.Decimal(15, 4)
  // Cotação vem de `marketAsset` (null para tipos sem cotação de mercado)
  marketAssetId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  marketAsset MarketAsset?  @relation(fields: [marketAssetId], references: [id], onDelete: SetNull)
  priceAlerts PriceAlert[]

  @@unique([userId, ticker])
  @@index([userId])
  @@index([categoryId])
  @@index([marketAssetId])
  @@index([ticker])
  @@map("asset_wishlists")
  @@schema("finance-assets")
}

/// Catálogo de ativos com cotação de mercado, compartilhado entre usuários.
/// Uma linha por ticker + tipo: a cotação é buscada uma vez e reaproveitada
/// por todos os `assets` e `asset_wishlists` que apontam para ela.
model MarketAsset {
  id                  String       @id @default(uuid())
  ticker              String
  type                CategoryType
  name                String
  currentClosePrice   Decimal?     @db.Decimal(15, 4)
  lastMonthClosePrice Decimal?     @db.Decimal(15, 4)
  priceUpdatedAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  assets      Asset[]
  wishlists   AssetWishlists[]
  priceAlerts PriceAlert[]

  @@unique([ticker, type])
  @@map("market_assets")
  @@schema("finance-assets")
}

/// Alerta de preço de um ativo da carteira ou de um item da wishlist
/// (exatamente um dos dois). Vigia a cotação do `marketAsset`: ao atingir o
/// alvo notifica e fica TRIGGERED; ao sair da faixa volta a ARMED sozinho.
model PriceAlert {
  id                 String              @id @default(uuid())
  userId             String
  marketAssetId      String
  assetId            String?
  wishlistId         String?
  /// Na moeda da categoria da origem
  targetPrice        Decimal             @db.Decimal(15, 4)
  /// ABOVE: avisa quando subir até o alvo; BELOW: quando cair até ele
  direction          PriceAlertDirection
  status             PriceAlertStatus    @default(ARMED)
  lastTriggeredAt    DateTime?
  lastTriggeredPrice Decimal?            @db.Decimal(15, 4)
  triggerCount       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketAsset MarketAsset     @relation(fields: [marketAssetId], references: [id], onDelete: Cascade)
  asset       Asset?          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  wishlist    AssetWishlists? @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@index([marketAssetId])
  @@index([userId])
  @@index([assetId])
  @@index([wishlistId])
  @@map("price_alerts")
  @@schema("finance-assets")
}

enum PriceAlertDirection {
  ABOVE
  BELOW

  @@schema("finance-assets")
}

enum PriceAlertStatus {
  /// Vigiando: notifica quando a cotação atingir o alvo
  ARMED
  /// Alvo atingido: volta a ARMED quando a cotação sair da faixa
  TRIGGERED

  @@schema("finance-assets")
}

model AssetCategoryCompetence {
  id         String @id @default(uuid())
  categoryId String
  year       Int

  category AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, year])
  @@index([categoryId])
  @@index([categoryId, year])
  @@map("asset_category_competences")
  @@schema("finance-assets")
}

model AssetRecord {
  id                 String   @id @default(uuid())
  categoryId         String
  month              Int
  year               Int
  amount             Decimal  @db.Decimal(15, 2)
  exchangeRate       Decimal? @db.Decimal(10, 4)
  dividendAmount     Decimal? @db.Decimal(15, 2)
  contributionAmount Decimal? @db.Decimal(15, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month, year])
  @@index([categoryId])
  @@index([categoryId, month])
  @@index([categoryId, year])
  @@index([categoryId, month, year])
  @@map("asset_records")
  @@schema("finance-assets")
}

/// Operação de um ativo (compra, venda, eventos). Quando o ativo tem operações,
/// a quantidade e o preço médio dele são calculados a partir delas.
model AssetTransaction {
  id           String            @id @default(uuid())
  assetId      String
  userId       String
  type         TransactionType
  source       TransactionSource @default(MANUAL)
  /// Data do negócio (ou do evento)
  date         DateTime          @db.Date
  /// OPENING, BUY, SELL e BONUS; nulo em SPLIT e REVERSE_SPLIT
  quantity     Decimal?          @db.Decimal(20, 8)
  /// Preço unitário na moeda da categoria (BONUS: custo atribuído por ação)
  price        Decimal?          @db.Decimal(15, 6)
  /// Corretagem, emolumentos e taxas, na moeda da categoria
  fees         Decimal           @default(0) @db.Decimal(15, 2)
  /// SPLIT e REVERSE_SPLIT: proporção (2 = cada ação vira 2, ou 2 viram 1)
  factor       Decimal?          @db.Decimal(12, 6)
  /// Cotação para BRL (categorias em moeda estrangeira)
  exchangeRate Decimal?          @db.Decimal(12, 6)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
  @@index([userId, date])
  @@map("asset_transactions")
  @@schema("finance-assets")
}

enum TransactionType {
  /// Posição de antes do registro de operações
  OPENING
  BUY
  SELL
  /// Desdobramento
  SPLIT
  /// Grupamento
  REVERSE_SPLIT
  /// Bonificação em ações
  BONUS

  @@schema("finance-assets")
}

enum TransactionSource {
  MANUAL
  IMPORT

  @@schema("finance-assets")
}

model AssetDividend {
  id           String         @id @default(uuid())
  assetId      String
  userId       String
  type         DividendType   @default(DIVIDEND)
  source       DividendSource @default(MANUAL)
  amount       Decimal        @db.Decimal(15, 2)
  rateAmount   Decimal?       @db.Decimal(15, 4)
  quantity     Decimal?       @db.Decimal(15, 8)
  taxAmount    Decimal?       @db.Decimal(15, 2)
  exchangeRate Decimal?       @db.Decimal(10, 4)
  comDate      DateTime?
  paymentDate  DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assetId, type, paymentDate])
  @@index([userId, paymentDate])
  @@index([assetId])
  @@map("asset_dividends")
  @@schema("finance-assets")
}

enum DividendType {
  DIVIDEND
  JCP
  INCOME
  OTHER

  @@schema("finance-assets")
}

enum DividendSource {
  MANUAL
  SYNC

  @@schema("finance-assets")
}

enum CategoryType {
  VARIABLE_BR
  FII
  VARIABLE_US
  CRYPTO
  FIXED

  @@schema("finance-assets")
}

model BenchmarkReturn {
  id        String        @id @default(uuid())
  benchmark BenchmarkType
  year      Int
  month     Int
  /// Retorno do mês em % (ex.: 1.0523 = +1,0523%)
  returnPct Decimal       @db.Decimal(12, 6)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([benchmark, year, month])
  @@index([benchmark, year, month])
  @@map("benchmark_returns")
  @@schema("finance-assets")
}

enum FixedIncomeIndexer {
  CDI
  IPCA
  PRE

  @@schema("finance-assets")
}

/// Cache global (sem usuário) dos indicadores do Banco Central usados na renda fixa
model IndicatorRate {
  id        String            @id @default(uuid())
  indicator EconomicIndicator
  /// CDI: dia útil; IPCA: dia 1º do mês de referência
  date      DateTime          @db.Date
  /// CDI: % ao dia; IPCA: % no mês
  ratePct   Decimal           @db.Decimal(12, 8)
  createdAt DateTime          @default(now())

  @@unique([indicator, date])
  @@map("indicator_rates")
  @@schema("finance-assets")
}

enum EconomicIndicator {
  CDI
  IPCA

  @@schema("finance-assets")
}

enum BenchmarkType {
  CDI
  IBOV
  SP500_BRL
  /// IFIX pelo ETF XFIX11 (reinveste os rendimentos)
  IFIX
  BTC_BRL

  @@schema("finance-assets")
}

/// Bem físico ou passivo que compõe o patrimônio líquido (Net Worth), fora das categorias de investimento
model PatrimonyItem {
  id            String            @id @default(uuid())
  userId        String
  name          String
  type          PatrimonyItemType
  /// Valor atual estimado em BRL (sempre positivo; o tipo LIABILITY define o sinal na soma)
  currentValue  Decimal           @db.Decimal(15, 2)
  /// Valor de aquisição original (opcional, para valorização/depreciação)
  purchaseValue Decimal?          @db.Decimal(15, 2)
  acquiredAt    DateTime?         @db.Date
  notes         String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("patrimony_items")
  @@schema("finance-assets")
}

enum PatrimonyItemType {
  REAL_ESTATE
  VEHICLE
  EQUIPMENT
  OTHER_ASSET
  LIABILITY

  @@schema("finance-assets")
}
