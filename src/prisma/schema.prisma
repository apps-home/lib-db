generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["better-auth", "finance-assets"]
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  assetCategories AssetCategory[]
  assetWishlists  AssetWishlists[]
  assetDividends  AssetDividend[]

  @@unique([email])
  @@index([email])
  @@map("user")
  @@schema("better-auth")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("better-auth")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
  @@schema("better-auth")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("better-auth")
}

model Asset {
  id                  String    @id @default(uuid())
  categoryId          String
  name                String
  ticker              String
  quantity            Decimal?  @db.Decimal(15, 8)
  averagePrice        Decimal?  @db.Decimal(15, 4)
  broker              String?
  isActive            Boolean   @default(true)
  // Ativo com cotação de mercado: o preço vem de `marketAsset`
  marketAssetId       String?
  // Preço manual, usado só sem `marketAsset` (ex.: renda fixa)
  currentClosePrice   Decimal?  @db.Decimal(15, 4)
  // Quando o histórico de proventos foi importado (backfill); null = ainda não importado
  dividendsImportedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  category    AssetCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  marketAsset MarketAsset?    @relation(fields: [marketAssetId], references: [id], onDelete: SetNull)
  dividends   AssetDividend[]

  @@index([categoryId])
  @@index([marketAssetId])
  @@index([ticker])
  @@index([categoryId, ticker])
  @@map("assets")
  @@schema("finance-assets")
}

model AssetCategory {
  id               String       @id @default(uuid())
  userId           String
  name             String
  type             CategoryType @default(FIXED)
  targetPercentage Decimal?     @db.Decimal(5, 2)
  currency         String       @default("BRL")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  records        AssetRecord[]
  competences    AssetCategoryCompetence[]
  assets         Asset[]
  assetWishlists AssetWishlists[]
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("asset_categories")
  @@schema("finance-assets")
}

model AssetWishlists {
  id            String   @id @default(uuid())
  userId        String
  categoryId    String
  name          String
  ticker        String
  targetPrice   Decimal? @db.Decimal(15, 4)
  // Cotação vem de `marketAsset` (null para tipos sem cotação de mercado)
  marketAssetId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  marketAsset MarketAsset?  @relation(fields: [marketAssetId], references: [id], onDelete: SetNull)

  @@unique([userId, ticker])
  @@index([userId])
  @@index([categoryId])
  @@index([marketAssetId])
  @@index([ticker])
  @@map("asset_wishlists")
  @@schema("finance-assets")
}

/// Catálogo de ativos com cotação de mercado, compartilhado entre usuários.
/// Uma linha por ticker + tipo: a cotação é buscada uma vez e reaproveitada
/// por todos os `assets` e `asset_wishlists` que apontam para ela.
model MarketAsset {
  id                  String       @id @default(uuid())
  ticker              String
  type                CategoryType
  name                String
  currentClosePrice   Decimal?     @db.Decimal(15, 4)
  lastMonthClosePrice Decimal?     @db.Decimal(15, 4)
  priceUpdatedAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  assets    Asset[]
  wishlists AssetWishlists[]

  @@unique([ticker, type])
  @@map("market_assets")
  @@schema("finance-assets")
}

model AssetCategoryCompetence {
  id         String @id @default(uuid())
  categoryId String
  year       Int

  category AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, year])
  @@index([categoryId])
  @@index([categoryId, year])
  @@map("asset_category_competences")
  @@schema("finance-assets")
}

model AssetRecord {
  id                 String   @id @default(uuid())
  categoryId         String
  month              Int
  year               Int
  amount             Decimal  @db.Decimal(15, 2)
  exchangeRate       Decimal? @db.Decimal(10, 4)
  dividendAmount     Decimal? @db.Decimal(15, 2)
  contributionAmount Decimal? @db.Decimal(15, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month, year])
  @@index([categoryId])
  @@index([categoryId, month])
  @@index([categoryId, year])
  @@index([categoryId, month, year])
  @@map("asset_records")
  @@schema("finance-assets")
}

model AssetDividend {
  id           String         @id @default(uuid())
  assetId      String
  userId       String
  type         DividendType   @default(DIVIDEND)
  source       DividendSource @default(MANUAL)
  amount       Decimal        @db.Decimal(15, 2)
  rateAmount   Decimal?       @db.Decimal(15, 4)
  quantity     Decimal?       @db.Decimal(15, 8)
  taxAmount    Decimal?       @db.Decimal(15, 2)
  exchangeRate Decimal?       @db.Decimal(10, 4)
  comDate      DateTime?
  paymentDate  DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assetId, type, paymentDate])
  @@index([userId, paymentDate])
  @@index([assetId])
  @@map("asset_dividends")
  @@schema("finance-assets")
}

enum DividendType {
  DIVIDEND
  JCP
  INCOME
  OTHER

  @@schema("finance-assets")
}

enum DividendSource {
  MANUAL
  SYNC

  @@schema("finance-assets")
}

enum CategoryType {
  VARIABLE_BR
  FII
  VARIABLE_US
  CRYPTO
  FIXED

  @@schema("finance-assets")
}

model BenchmarkReturn {
  id        String        @id @default(uuid())
  benchmark BenchmarkType
  year      Int
  month     Int
  /// Retorno do mês em % (ex.: 1.0523 = +1,0523%)
  returnPct Decimal       @db.Decimal(12, 6)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([benchmark, year, month])
  @@index([benchmark, year, month])
  @@map("benchmark_returns")
  @@schema("finance-assets")
}

enum BenchmarkType {
  CDI
  IBOV
  SP500_BRL

  @@schema("finance-assets")
}
